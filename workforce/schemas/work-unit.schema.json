{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISDF Work Unit",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "worker_id",
    "action",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string"
    },
    "action": {
      "enum": [
        "observe",
        "analyze",
        "propose",
        "write",
        "execute",
        "external_access",
        "destructive_change",
        "release",
        "deploy",
        "security_test"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "human_approval_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
