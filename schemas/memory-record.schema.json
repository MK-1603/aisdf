{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisdf.dev/schemas/memory-record.schema.json",
  "title": "AISDF Persistent Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "memory_type",
    "scope",
    "statement",
    "classification",
    "status",
    "source_refs",
    "recorded_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "memory_type": {
      "enum": [
        "project_fact",
        "decision",
        "session_checkpoint",
        "lesson",
        "preference",
        "knowledge_reference"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "status": {
      "enum": [
        "CURRENT",
        "REVIEW_DUE",
        "STALE",
        "SUPERSEDED",
        "DISPUTED",
        "UNVERIFIED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string"
          },
          "revision_or_date": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
