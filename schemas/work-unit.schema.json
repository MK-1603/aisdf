{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisdf.dev/schemas/work-unit.schema.json",
  "title": "Work Unit",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "objective",
    "status",
    "permissions",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "COMPLETE",
        "FAILED",
        "CANCELLED"
      ]
    },
    "baseline_revision": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "write",
          "execute",
          "network",
          "commit",
          "push",
          "merge",
          "deploy"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED",
              "NOT_APPLICABLE",
              "WAIVED"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
